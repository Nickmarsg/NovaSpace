---
interface Props {
  brand?: string;
  mode?: string;
}

const { brand = "Nova Space", mode = "PhotoStudio + VR" } = Astro.props;
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=%D0%BC.+%D0%91%D1%80%D0%BE%D0%B2%D0%B0%D1%80%D0%B8,+%D0%B2%D1%83%D0%BB.+%D0%AF%D1%80%D0%BE%D1%81%D0%BB%D0%B0%D0%B2%D0%B0+%D0%9C%D1%83%D0%B4%D1%80%D0%BE%D0%B3%D0%BE,+28";
const studioInstagramUrl = "https://www.instagram.com/nova_photostudio_/";
const vrInstagramUrl = "https://www.instagram.com/novaspace_vr/";
const vrTikTokUrl = "https://www.tiktok.com/@www.tiktok.novaspace_vr";
---

<footer id="footer-contacts" class="footer reveal">
  <div class="footer__brand">
    <a class="brand" href="/">
      <span>{brand}</span>
      <small>{mode}</small>
    </a>
    <p>Nova Space об'єднує Nova PhotoStudio та Nova VR у Броварах: зйомки, ігри, події й бронювання в одному просторі.</p>
    <div class="footer__credit">
      <span>Зв'язок / Design by</span>
      <a href="https://app.esvarpoul.pp.ua/" target="_blank" rel="noreferrer">Esvar Poul</a>
    </div>
  </div>

  <div class="footer__details">
    <address>
      <strong>Контакти</strong>
      <a href={mapsUrl} target="_blank" rel="noreferrer">м. Бровари, вул. Ярослава Мудрого, 28, вхід зі сторони двору</a>
      <a href="tel:+380660097630">066 009 76 30</a>
      <a href={vrInstagramUrl} target="_blank" rel="noreferrer">@novaspace_vr</a>
      <a href={studioInstagramUrl} target="_blank" rel="noreferrer">@nova_photostudio_</a>
      <a href={vrTikTokUrl} target="_blank" rel="noreferrer">TikTok @www.tiktok.novaspace_vr</a>
      <span>Оренда — 600 грн./год.</span>
      <span class="footer__schedule"><span>Щодня, крім середи</span><span>11-20</span></span>
    </address>

    <nav class="footer__links" aria-label="NOVA navigation">
      <a href="/studio/">Nova PhotoStudio</a>
      <a href="/vr/">Nova VR</a>
      <a href="/booking/">Бронювання</a>
      <a href="/">Nova Space</a>
    </nav>
  </div>

  <a class="footer__map" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Відкрити адресу Nova PhotoStudio у Google Maps">
    <img src="/studio/studio-map-preview.png" alt="" loading="lazy" />
    <span class="footer__map-copy">
      <small>Google Maps</small>
      <strong>м. Бровари, вул. Ярослава Мудрого, 28</strong>
      <em>Відкрити маршрут</em>
    </span>
  </a>

  <p class="footer__legal">
    <span>© 2026 Nova Space</span>
    <span>Усі права захищені. Копіювання матеріалів сайту без дозволу заборонено.</span>
  </p>
</footer>
