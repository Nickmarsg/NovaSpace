---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import MobileActionBar from "../components/layout/MobileActionBar.astro";
import { bookingServices } from "../data/bookingServices.js";
import { address, makeBreadcrumbSchema, mapsUrl, novaPhotoStudioSchema, novaVrSchema, organizationSchema, siteUrl, webSiteSchema } from "../data/seo.js";

const pageUrl = `${siteUrl}/brovary/`;
const phoneDisplay = "066 009 76 30";
const studioInstagramUrl = "https://www.instagram.com/nova_photostudio_/";
const vrInstagramUrl = "https://www.instagram.com/novaspace_vr/";
const vrTikTokUrl = "https://www.tiktok.com/@www.tiktok.novaspace_vr";
const serviceBySlug = Object.fromEntries(bookingServices.map((service) => [service.slug, service]));
const infoServices = [
  {
    name: "Nova PhotoStudio",
    label: "Фотостудія",
    text: "Оренда світлої фотостудії у Броварах для портретів, сімейних фото, beauty-зйомок, контенту та зйомок для брендів.",
    items: ["оренда студії", "портретна зйомка", "сімейна фотосесія", "контент-зйомка"]
  },
  {
    name: "NOVA VR",
    label: "VR клуб",
    text: "VR клуб у Броварах для ігор у віртуальній реальності, PlayStation 5, днів народження, побачень, компаній і корпоративів.",
    items: ["VR-ігри", "PlayStation 5", "дні народження", "корпоративи та події"]
  }
];
const priceRows = [
  {
    name: "Оренда фотостудії",
    price: "600 грн./год.",
    note: "1 година оренди Nova PhotoStudio"
  },
  {
    name: serviceBySlug["vr-30"].name,
    price: `${serviceBySlug["vr-30"].price_day} / ${serviceBySlug["vr-30"].price_evening}`,
    note: "30 хв за одну VR-зону: денний / вечірній тариф"
  },
  {
    name: serviceBySlug["vr-60"].name,
    price: `${serviceBySlug["vr-60"].price_day} / ${serviceBySlug["vr-60"].price_evening}`,
    note: "60 хв за одну VR-зону: денний / вечірній тариф"
  },
  {
    name: serviceBySlug["ps5-60-1"].name,
    price: `${serviceBySlug["ps5-60-1"].price_day} / ${serviceBySlug["ps5-60-1"].price_evening}`,
    note: "PS5-зона від 1 людини: денний / вечірній тариф"
  },
  {
    name: serviceBySlug["birthday-3h"].name,
    price: `${serviceBySlug["birthday-3h"].price_day} / ${serviceBySlug["birthday-3h"].price_evening}`,
    note: "пакет на 3 години, вартість залежить від кількості гостей"
  }
];
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Nova Space Бровари",
  description: "Nova Space у Броварах: Nova PhotoStudio, NOVA VR, послуги, ціни, адреса, телефон і соцмережі.",
  inLanguage: "uk-UA",
  isPartOf: {
    "@id": `${siteUrl}/#website`
  },
  publisher: {
    "@id": `${siteUrl}/#organization`
  },
  about: [
    { "@id": `${siteUrl}/vr/#localbusiness` },
    { "@id": `${siteUrl}/studio/#localbusiness` }
  ],
  mainEntity: {
    "@type": "ItemList",
    name: "Напрями Nova Space у Броварах",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "NOVA VR",
        url: `${siteUrl}/vr/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Nova PhotoStudio",
        url: `${siteUrl}/studio/`
      }
    ]
  }
};
const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: "Бровари", url: pageUrl }
]);
---

<BaseLayout
  title="Nova Space Бровари | Послуги, ціни і контакти"
  description="Nova Space у Броварах: Nova PhotoStudio від 600 грн./год., NOVA VR, PS5, дні народження, адреса вул. Ярослава Мудрого, 28, телефон 066 009 76 30."
  canonicalPath="/brovary/"
  image="/vr/nova-space-logo.webp"
  schema={[organizationSchema, webSiteSchema, novaVrSchema, novaPhotoStudioSchema, pageSchema, breadcrumbSchema]}
>
  <div class="app-shell brovary-page brovary-page--bridge">
    <Header
      brand="Nova Space"
      sub="Бровари"
      nav={[
        { label: "Послуги", href: "#services" },
        { label: "Ціни", href: "#prices" },
        { label: "Контакти", href: "#contacts" }
      ]}
      schedule="Щодня, крім середи|11-20"
      ctaHref="#services"
      ctaLabel="Послуги"
    />

    <main>
      <section class="brovary-hero" aria-labelledby="brovary-title">
        <div class="brovary-hero__copy">
          <nav class="brovary-breadcrumbs" aria-label="Навігаційний шлях">
            <a href="/">Nova Space</a>
            <span>/</span>
            <strong>Бровари</strong>
          </nav>
          <span class="brovary-kicker">Локація у Броварах</span>
          <h1 id="brovary-title">Nova Space Бровари</h1>
          <p>
            Nova Space - це Nova PhotoStudio та NOVA VR за адресою м. Бровари, {address.streetAddress}.
            Тут можна орендувати фотостудію, провести зйомку, пограти у VR, забронювати PS5 або організувати день народження.
          </p>
          <div class="brovary-actions">
            <a class="brovary-button brovary-button--primary" href="#prices">Подивитися ціни</a>
            <a class="brovary-button" href="#contacts">Контакти</a>
          </div>
        </div>
        <div class="brovary-hero__media" aria-label="Nova Space у Броварах">
          <img src="/vr/nova-vr-about-players.webp" alt="NOVA VR у Броварах" loading="eager" />
          <img src="/studio/studio-hero-floral-640.webp" alt="Nova PhotoStudio у Броварах" loading="eager" width="640" height="961" />
          <img src="/vr/nova-vr-about-ps5.webp" alt="PS5 зона у Nova Space" loading="lazy" />
        </div>
      </section>

      <section class="brovary-stats" aria-label="Ключові деталі Nova Space">
        <article>
          <span>Адреса</span>
          <strong>м. Бровари, {address.streetAddress}</strong>
        </article>
        <article>
          <span>Фотостудія</span>
          <strong>600 грн./год.</strong>
        </article>
        <article>
          <span>NOVA VR</span>
          <strong>VR + PS5 + свята</strong>
        </article>
        <article>
          <span>Телефон</span>
          <strong>{phoneDisplay}</strong>
        </article>
      </section>

      <section id="services" class="brovary-section brovary-section--info" aria-labelledby="brovary-services-title">
        <div class="brovary-section__head">
          <span class="brovary-kicker">Послуги</span>
          <h2 id="brovary-services-title">Назва і послуги</h2>
          <p>У Nova Space працюють два напрями: фотостудія для зйомок та VR клуб для ігор і подій.</p>
        </div>
        <div class="brovary-link-grid brovary-link-grid--info">
          {infoServices.map((service) => (
            <article>
              <span>{service.label}</span>
              <h3>{service.name}</h3>
              <p>{service.text}</p>
              <ul>
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="prices" class="brovary-section brovary-section--prices" aria-labelledby="brovary-prices-title">
        <div class="brovary-section__head">
          <span class="brovary-kicker">Ціни</span>
          <h2 id="brovary-prices-title">Базові ціни</h2>
          <p>Ціни вказані звичайним текстом. Для VR денний тариф діє у будні до 17:00, вечірній - після 17:00 та у п'ятницю-неділю.</p>
        </div>
        <div class="brovary-link-grid brovary-link-grid--prices">
          {priceRows.map((row) => (
            <article>
              <span>{row.name}</span>
              <strong>{row.price}</strong>
              <em>{row.note}</em>
            </article>
          ))}
        </div>
      </section>

      <section id="contacts" class="brovary-contact" aria-labelledby="brovary-contact-title">
        <div>
          <span class="brovary-kicker">Контакти</span>
          <h2 id="brovary-contact-title">Контакти Nova Space</h2>
          <p>
            Адреса: м. {address.addressLocality}, {address.streetAddress}. Моб. телефон: {phoneDisplay}.
            Instagram фотостудії: @nova_photostudio_, Instagram VR: @novaspace_vr, TikTok VR: @www.tiktok.novaspace_vr.
          </p>
        </div>
        <div class="brovary-contact__actions">
          <a href="/studio/">Nova PhotoStudio</a>
          <a href="/vr/">NOVA VR</a>
          <a href="tel:+380660097630">066 009 76 30</a>
          <a href={studioInstagramUrl} target="_blank" rel="noreferrer">Instagram студії</a>
          <a href={vrInstagramUrl} target="_blank" rel="noreferrer">Instagram VR</a>
          <a href={vrTikTokUrl} target="_blank" rel="noreferrer">TikTok VR</a>
          <a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps</a>
        </div>
      </section>
    </main>

    <Footer brand="Nova Space" mode="Бровари" />
  </div>

  <MobileActionBar
    primaryHref="/vr/"
    primaryLabel="NOVA VR"
    secondaryHref="/studio/"
    secondaryLabel="PhotoStudio"
  />
</BaseLayout>
