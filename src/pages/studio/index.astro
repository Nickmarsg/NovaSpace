---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import MobileActionBar from "../../components/layout/MobileActionBar.astro";
import StudioHero from "../../components/studio/StudioHero.astro";
import StudioServices from "../../components/studio/StudioServices.astro";
import StudioPortfolio from "../../components/studio/StudioPortfolio.astro";
import StudioBookingCTA from "../../components/studio/StudioBookingCTA.astro";
import { makeBreadcrumbSchema, makeWebPageSchema, novaPhotoStudioSchema, organizationSchema, siteUrl, webSiteSchema } from "../../data/seo.js";
import { studioNav } from "../../data/studio.js";

const pageTitle = "Nova PhotoStudio | Фотостудія Бровари для портретів і контенту";
const pageDescription = "Nova PhotoStudio у Броварах: світла фотостудія для портретних, сімейних, beauty та контент-зйомок. Оренда простору і фотограф за потреби.";
const studioPageSchema = makeWebPageSchema({
  path: "/studio/",
  name: pageTitle,
  description: pageDescription,
  image: "/studio/studio-hero-floral-1066.webp",
  about: { "@id": `${siteUrl}/studio/#localbusiness` },
  mainEntity: { "@id": `${siteUrl}/studio/#localbusiness` }
});
const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: "Nova PhotoStudio", url: "/studio/" }
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/studio/"
  image="/studio/studio-hero-floral-1066.webp"
  favicon="studio"
  schema={[organizationSchema, webSiteSchema, novaPhotoStudioSchema, studioPageSchema, breadcrumbSchema]}
>
  <div class="app-shell studio-page">
    <Header brand="Nova Space" sub="Nova PhotoStudio" nav={studioNav} schedule="Щодня, крім середи|11-20" ctaHref="#booking" ctaLabel="Забронювати" />
    <main>
      <StudioHero />
      <StudioServices />
      <StudioPortfolio />
      <StudioBookingCTA />
    </main>
    <Footer brand="Nova Space" mode="Nova PhotoStudio" />
  </div>
  <MobileActionBar
    primaryHref="#booking"
    primaryLabel="Забронювати"
    secondaryHref="tel:+380660097630"
    secondaryLabel="Дзвінок"
    class="mobile-action-bar--studio"
  />
</BaseLayout>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = document.querySelector("[data-menu-toggle]");

  toggle?.addEventListener("click", () => {
    const isOpen = header?.classList.toggle("is-menu-open") || false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  const items = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  items.forEach((item) => observer.observe(item));

</script>
