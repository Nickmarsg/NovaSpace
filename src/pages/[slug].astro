---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import MobileActionBar from "../components/layout/MobileActionBar.astro";
import { address, makeBreadcrumbSchema, mapsUrl, novaPhotoStudioSchema, novaVrSchema, organizationSchema, phone, siteUrl, webSiteSchema } from "../data/seo.js";
import { studioLandingPages } from "../data/studioLandingPages.js";
import { vrLandingPages } from "../data/vrLandingPages.js";

interface VrLandingPage {
  type?: "vr" | "studio";
  slug: string;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  image: string;
  imageAlt: string;
  primaryCta: string;
  secondaryCta: string;
  bookingServiceSlug?: string;
  highlights: string[];
  sections: Array<{
    title: string;
    text: string;
  }>;
  stats: Array<{
    label: string;
    value: string;
  }>;
  faq: Array<{
    question: string;
    answer: string;
  }>;
}

export function getStaticPaths() {
  return [...(vrLandingPages as VrLandingPage[]), ...(studioLandingPages as VrLandingPage[])].map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: VrLandingPage };
const isStudioLanding = page.type === "studio";
const bookingServiceSlug =
  page.bookingServiceSlug ||
  (isStudioLanding
    ? "studio-rent"
    : page.slug === "den-narodzhennya-vr-brovary"
      ? "birthday-3h"
      : page.slug === "ps5-brovary"
        ? "ps5-60-1"
        : "vr-60");
const bookingPath = `/booking/?service=${bookingServiceSlug}`;
const pageUrl = `${siteUrl}/${page.slug}/`;
const addressText = `${address.streetAddress}, ${address.addressLocality}`;
const parentPage = isStudioLanding
  ? { name: "Nova PhotoStudio", url: `${siteUrl}/studio/`, path: "/studio/" }
  : { name: "NOVA VR", url: `${siteUrl}/vr/`, path: "/vr/" };
const businessSchema = isStudioLanding ? novaPhotoStudioSchema : novaVrSchema;
const providerId = `${siteUrl}/${isStudioLanding ? "studio" : "vr"}/#localbusiness`;
const schedule = "Щодня, крім середи|11-20";
const instagramUrl = isStudioLanding ? "https://www.instagram.com/nova_photostudio_/" : "https://www.instagram.com/novaspace_vr/";
const instagramLabel = isStudioLanding ? "@nova_photostudio_" : "@novaspace_vr";
const tiktokUrl = "https://www.tiktok.com/@www.tiktok.novaspace_vr";
const contactTitle = isStudioLanding ? "Nova PhotoStudio у Броварах" : "NOVA VR у Броварах";
const contactText = isStudioLanding
  ? `Адреса: ${addressText}. Світла студія для оренди та зйомок.`
  : `Адреса: ${addressText}. VR, PS5, дні народження та компанії.`;
const factHighlights = page.highlights.slice(0, 3);
const faqPreview = page.faq.slice(0, 2);
const keyStat = page.stats[0] ? `${page.stats[0].label}: ${page.stats[0].value}.` : "";
const entryLead = `${page.eyebrow}: ${page.highlights[0]}. ${keyStat} Бронювання онлайн.`;

const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: parentPage.name, url: parentPage.url },
  { name: page.h1, url: pageUrl }
]);

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: page.title,
  description: page.description,
  inLanguage: "uk-UA",
  isPartOf: {
    "@id": `${siteUrl}/#website`
  },
  publisher: {
    "@id": `${siteUrl}/#organization`
  },
  about: {
    "@id": providerId
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${page.image}`
  }
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: page.h1,
  description: page.lead,
  provider: {
    "@id": providerId
  },
  areaServed: {
    "@type": "City",
    name: "Бровари"
  },
  serviceType: page.eyebrow,
  potentialAction: {
    "@type": "ReserveAction",
    name: page.primaryCta,
    target: {
      "@type": "EntryPoint",
      urlTemplate: new URL(bookingPath, siteUrl).toString(),
      inLanguage: "uk-UA",
      actionPlatform: [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform"
      ]
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqPreview.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
const schema = [
  organizationSchema,
  webSiteSchema,
  businessSchema,
  webPageSchema,
  serviceSchema,
  breadcrumbSchema,
  ...(faqPreview.length ? [faqSchema] : [])
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={`/${page.slug}/`}
  image={page.image}
  favicon={isStudioLanding ? "studio" : "vr"}
  schema={schema}
>
  <div class={`vr-local-page vr-entry-page${isStudioLanding ? " vr-local-page--studio" : ""}`}>
    <Header
      brand="Nova Space"
      sub={parentPage.name}
      nav={[
        { label: parentPage.name, href: parentPage.path },
        { label: "Бронювання", href: bookingPath },
        { label: "Контакти", href: "#contacts" }
      ]}
      schedule={schedule}
      ctaHref={bookingPath}
      ctaLabel="Забронювати"
    />

    <main>
      <section class="vr-local-hero" aria-labelledby="vr-local-title">
        <div class="vr-local-hero__copy">
          <nav class="vr-local-breadcrumbs" aria-label="Навігаційний шлях">
            <a href="/">Nova Space</a>
            <span>/</span>
            <a href={parentPage.path}>{parentPage.name}</a>
            <span>/</span>
            <strong>{page.eyebrow}</strong>
          </nav>
          <span class="vr-local-kicker">{page.eyebrow}</span>
          <h1 id="vr-local-title">{page.h1}</h1>
          <p>{entryLead}</p>
          <div class="vr-local-actions">
            <a class="vr-local-button vr-local-button--primary" href={bookingPath}>{page.primaryCta}</a>
            <a class="vr-local-button" href={parentPage.path}>{page.secondaryCta}</a>
          </div>
        </div>
        <figure class="vr-local-hero__media">
          <img src={page.image} alt={page.imageAlt} width="800" height="500" loading="eager" />
          <figcaption>
            <span>Бровари</span>
            <strong>{address.streetAddress}</strong>
          </figcaption>
        </figure>
      </section>

      <section class="vr-local-stats" aria-label="Ключові деталі">
        {page.stats.slice(0, 3).map((stat) => (
          <article>
            <span>{stat.label}</span>
            <strong>{stat.value}</strong>
          </article>
        ))}
      </section>

      <section class="vr-local-grid" aria-labelledby="vr-local-includes">
        <div>
          <span class="vr-local-kicker">Коротко</span>
          <h2 id="vr-local-includes">Чому цей формат зручний</h2>
          <p>Це швидкий вхід зі сторінки пошуку. Основні деталі та доступний слот уточнюються у бронюванні.</p>
        </div>
        <div class="vr-local-points">
          {factHighlights.map((item) => (
            <article>
              <span></span>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </section>

      {faqPreview.length > 0 && (
        <section class="vr-local-faq" aria-labelledby="vr-local-faq-title">
          <div>
            <span class="vr-local-kicker">FAQ</span>
            <h2 id="vr-local-faq-title">Що уточнити перед візитом</h2>
          </div>
          <div>
            {faqPreview.map((item) => (
              <article>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer id="contacts" class="vr-local-contact">
      <div>
        <span class="vr-local-kicker">Контакти</span>
        <h2>{contactTitle}</h2>
        <p>{contactText}</p>
      </div>
      <div class="vr-local-contact__actions">
        <a href={bookingPath}>Забронювати</a>
        <a href={`tel:${phone}`}>+380 66 009 7630</a>
        <a href={mapsUrl} target="_blank" rel="noreferrer">Маршрут</a>
        <a href={instagramUrl} target="_blank" rel="noreferrer">{instagramLabel}</a>
        {!isStudioLanding && <a href={tiktokUrl} target="_blank" rel="noreferrer">TikTok VR</a>}
      </div>
    </footer>
  </div>

  <MobileActionBar
    primaryHref={bookingPath}
    primaryLabel="Забронювати"
    secondaryHref="tel:+380660097630"
    secondaryLabel="Дзвінок"
    class={isStudioLanding ? "mobile-action-bar--studio" : "mobile-action-bar--vr"}
  />
</BaseLayout>
