---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import Header from "../../components/layout/Header.astro";
import MobileActionBar from "../../components/layout/MobileActionBar.astro";
import BookingWidget from "../../components/booking/BookingWidget.astro";
import { faqItems } from "../../data/faq.js";
import { bookingServices } from "../../data/bookingServices.js";
import { makeBreadcrumbSchema, makeItemListSchema, makeWebPageSchema, novaVrSchema, organizationSchema, siteUrl, webSiteSchema } from "../../data/seo.js";
import { vrScenarios } from "../../data/vr.js";

const pageTitle = "NOVA VR | VR клуб Бровари, ігри, дні народження та PS5";
const pageDescription = "NOVA VR у Броварах: 6 VR-зон, PlayStation 5, ігри для дітей і дорослих, дні народження та онлайн-бронювання.";
const bookingHref = "#booking";
const formatBookingHref = (slug: string) => `?service=${slug}#booking`;
const birthdayHref = formatBookingHref("birthday-3h");
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=%D0%BC.+%D0%91%D1%80%D0%BE%D0%B2%D0%B0%D1%80%D0%B8,+%D0%B2%D1%83%D0%BB.+%D0%AF%D1%80%D0%BE%D1%81%D0%BB%D0%B0%D0%B2%D0%B0+%D0%9C%D1%83%D0%B4%D1%80%D0%BE%D0%B3%D0%BE,+28";
const designerUrl = "https://app.esvarpoul.pp.ua/";
const quickFormatSlugs = ["vr-60", "ps5-60-1", "novamix2-60", "birthday-3h"];
const vrBookingSlugs = bookingServices
  .filter((service) => service.area !== "studio")
  .map((service) => service.slug);
const quickFormats = quickFormatSlugs
  .map((slug) => bookingServices.find((service) => service.slug === slug))
  .filter(Boolean) as typeof bookingServices;
const scenarioPreview = [
  vrScenarios.find((item) => item.slug === "birthday"),
  vrScenarios.find((item) => item.slug === "kids")
].filter(Boolean) as typeof vrScenarios;
const faqPreview = faqItems.slice(0, 3);
const formatNotes: Record<string, string> = {
  "vr-60": "Класичний старт для 1-6 гравців.",
  "ps5-60-1": "PS5-зона від 1 людини або пауза між VR.",
  "novamix2-60": "VR + PS5 в одному візиті для двох.",
  "birthday-3h": "3 години, VR, PS5 і зона відпочинку."
};

const vrPageSchema = makeWebPageSchema({
  path: "/vr/",
  name: pageTitle,
  description: pageDescription,
  image: "/vr/nova-space-logo.webp",
  about: { "@id": `${siteUrl}/vr/#localbusiness` },
  mainEntity: { "@id": `${siteUrl}/vr/#localbusiness` }
});
const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: "NOVA VR", url: "/vr/" }
]);
const formatsSchema = makeItemListSchema({
  id: "/vr/#formats",
  name: "Швидкі формати бронювання NOVA VR",
  items: quickFormats.map((service) => ({
    name: service.name,
    url: `/vr/${formatBookingHref(service.slug)}`
  }))
});
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqPreview.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/vr/"
  image="/vr/nova-space-logo.webp"
  favicon="vr"
  schema={[organizationSchema, webSiteSchema, novaVrSchema, vrPageSchema, formatsSchema, breadcrumbSchema, faqSchema]}
>
  <div class="app-shell vr-lite-page">
    <Header
      brand="Nova Space"
      sub="NOVA VR"
      nav={[
        { label: "Формати", href: "#formats" },
        { label: "Ігри", href: "#games" },
        { label: "Свята", href: "#events" },
        { label: "Контакти", href: "#contacts" }
      ]}
      schedule="Щодня, крім середи|11-20"
      ctaHref={bookingHref}
      ctaLabel="Забронювати"
    />

    <main>
      <section class="vr-lite-hero" aria-labelledby="vr-title">
        <div class="vr-lite-hero__copy">
          <div class="vr-lite-hero__headline">
            <h1 id="vr-title">NOVA VR у Броварах</h1>
            <p>6 VR-шоломів, PlayStation 5, адміністратор поруч і бронювання онлайн.</p>
          </div>
          <div class="vr-lite-hero__conversion">
            <div class="vr-lite-actions">
              <a class="vr-lite-button vr-lite-button--primary" href={bookingHref}>Забронювати VR</a>
              <a class="vr-lite-button" href="#formats">Подивитися ціни</a>
            </div>
            <dl class="vr-lite-facts" aria-label="Коротко про NOVA VR">
              <div>
                <dt>VR-шоломів</dt>
                <dd class="vr-lite-headset-count" aria-label="6 VR-шоломів">
                  <span>6</span>
                  <svg viewBox="0 0 48 32" aria-hidden="true" focusable="false">
                    <path d="M9 14c1.3-5.7 6.5-9 15-9s13.7 3.3 15 9l2 9c.5 2.2-1.2 4-3.4 4h-8.4c-1.7 0-2.7-1-3.5-2.6-.7-1.4-2.7-1.4-3.4 0-.8 1.6-1.8 2.6-3.5 2.6h-8.4C8.2 27 6.5 25.2 7 23l2-9Z" />
                    <path d="M15 17h7M26 17h7M12.5 13.5C15.2 11.2 19 10 24 10s8.8 1.2 11.5 3.5" />
                  </svg>
                </dd>
              </div>
              <div>
                <dt>PS5</dt>
                <dd class="vr-lite-controller-count" aria-label="2 джойстики">
                  <span>2</span>
                  <svg viewBox="0 0 48 32" aria-hidden="true" focusable="false">
                    <path d="M14 9h20c5.6 0 9 4.4 9 11.2 0 4.1-2.2 6.8-5.2 6.8-2.1 0-3.4-1.1-4.8-3.2l-1.7-2.6H16.7L15 23.8C13.6 25.9 12.3 27 10.2 27 7.2 27 5 24.3 5 20.2 5 13.4 8.4 9 14 9Z" />
                    <path d="M16 14v8M12 18h8M30.5 17.5h.1M36 17.5h.1M33.2 14.8h.1M33.2 20.2h.1" />
                  </svg>
                </dd>
              </div>
              <div><dt>Графік</dt><dd>Щодня, крім середи 11-20</dd></div>
            </dl>
          </div>
        </div>
        <figure class="vr-lite-hero__media">
          <img src="/vr/nova-vr-about-players.webp" alt="Гості грають у NOVA VR у Броварах" width="800" height="500" loading="eager" />
          <figcaption>
            <span>Перший візит?</span>
            <strong>Пояснимо правила, підберемо гру і допоможемо зі стартом.</strong>
          </figcaption>
        </figure>
      </section>

      <section id="formats" class="vr-lite-section" aria-labelledby="formats-title">
        <div class="vr-lite-section__head">
          <span class="eyebrow">Формати</span>
          <h2 id="formats-title">Ціна і формат одразу</h2>
          <p>Оберіть сценарій, а доступний час побачите у бронюванні.</p>
        </div>
        <div class="vr-lite-format-grid">
          {quickFormats.map((service) => (
            <article>
              <span>{service.name}</span>
              <strong>{service.price_day}</strong>
              <p>{formatNotes[service.slug] || service.price_note}</p>
              <a href={formatBookingHref(service.slug)}>Забронювати</a>
            </article>
          ))}
        </div>
      </section>

      <section id="games" class="vr-lite-section vr-lite-section--games" aria-labelledby="games-title">
        <div class="vr-lite-section__head">
          <span class="eyebrow">Ігри</span>
          <h2 id="games-title">Багато жанрів, один швидкий вибір</h2>
          <p>Аркади, квести, командні місії, хорор, спорт і сімейні сценарії. Скажіть вік, досвід і настрій — адміністратор підбере гру на місці.</p>
        </div>
        <div class="vr-lite-game-stack" aria-label="Жанри VR-ігор">
          <article>
            <span>Аркади</span>
            <strong>легкий старт</strong>
          </article>
          <article>
            <span>Квести</span>
            <strong>спільні задачі</strong>
          </article>
          <article>
            <span>Командні</span>
            <strong>для компанії</strong>
          </article>
          <article>
            <span>Хорор</span>
            <strong>для сміливих</strong>
          </article>
          <article>
            <span>Сімейні</span>
            <strong>спокійний темп</strong>
          </article>
        </div>
      </section>

      <section id="events" class="vr-lite-section vr-lite-section--split vr-lite-section--events" aria-labelledby="events-title">
        <div class="vr-lite-section__head">
          <span class="eyebrow">Свята і компанії</span>
          <h2 id="events-title">День народження або компанія</h2>
          <p>Підкажемо сценарій, час і ротацію між VR, PS5 та відпочинком.</p>
          <div class="vr-lite-actions">
            <a class="vr-lite-button vr-lite-button--primary" href={birthdayHref}>Забронювати</a>
          </div>
        </div>
        <div class="vr-lite-event-list">
          {scenarioPreview.map((scenario) => (
            <article>
              <span>{scenario.teaser}</span>
              <h3>{scenario.title}</h3>
              <p>{scenario.bestFor}</p>
            </article>
          ))}
            <article>
              <span>PlayStation 5</span>
              <h3>PS5 як окрема зона</h3>
              <p>Для двох або як пауза між VR-раундами.</p>
            </article>
        </div>
      </section>

      <section class="vr-lite-section vr-lite-section--faq" aria-labelledby="vr-faq-title">
        <div class="vr-lite-section__head">
          <span class="eyebrow">Питання</span>
          <h2 id="vr-faq-title">Коротко перед бронюванням</h2>
        </div>
        <div class="vr-lite-faq-grid">
          {faqPreview.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="booking" class="vr-lite-section vr-lite-section--booking" aria-labelledby="vr-booking-title">
        <div class="vr-lite-section__head">
          <span class="eyebrow">Бронювання VR</span>
          <h2 id="vr-booking-title">Оберіть формат, дату і час</h2>
          <p>У цьому блоці доступні тільки формати NOVA VR: VR, PS5, NovaMix і день народження.</p>
        </div>
        <BookingWidget
          allowedServiceSlugs={vrBookingSlugs}
          defaultServiceSlug="vr-60"
          introTitle="Деталі VR-бронювання"
          introText="Оберіть формат, дату, слот і залиште контакт. Менеджер підтвердить VR-бронювання."
        />
      </section>

      <section id="contacts" class="vr-lite-contact vr-lite-contact--map" aria-labelledby="vr-contact-title">
        <div class="vr-lite-contact__copy">
          <span class="eyebrow">Контакти</span>
          <h2 id="vr-contact-title">NOVA VR, вул. Ярослава Мудрого, 28</h2>
          <p>Онлайн-бронювання створює заявку, менеджер підтверджує час і формат.</p>
          <a class="vr-lite-contact__credit" href={designerUrl} target="_blank" rel="noreferrer">
            <span>Design By</span>
            <strong>EsvarPoul</strong>
          </a>
          <div class="vr-lite-contact__actions">
            <a href={bookingHref}>Забронювати</a>
            <a href="tel:+380660097630">066 009 76 30</a>
            <a href="https://www.instagram.com/novaspace_vr/" target="_blank" rel="noreferrer">@novaspace_vr</a>
            <a href="https://www.tiktok.com/@www.tiktok.novaspace_vr" target="_blank" rel="noreferrer">TikTok VR</a>
          </div>
        </div>
        <a class="vr-lite-contact__map" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Відкрити маршрут до NOVA VR на Ярослава Мудрого, 28 у Google Maps">
          <img src="/studio/studio-map-preview.png" alt="Мапа до NOVA VR, вул. Ярослава Мудрого, 28 у Броварах" loading="lazy" />
          <span class="vr-lite-contact__map-copy">
            <small>Google Maps</small>
            <strong>Ярослава Мудрого, 28</strong>
            <em>Відкрити маршрут</em>
          </span>
        </a>
      </section>
    </main>

    <Footer brand="Nova Space" mode="NOVA VR" />
  </div>

  <MobileActionBar
    primaryHref={bookingHref}
    primaryLabel="Забронювати"
    secondaryHref="tel:+380660097630"
    secondaryLabel="Дзвінок"
    class="mobile-action-bar--vr"
  />
</BaseLayout>
